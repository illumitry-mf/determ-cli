{
  "name": "determ-cli",
  "version": "1.0.0",
  "description": "CLI for the Determ (Mediatoolkit) media monitoring API",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "determ": "dist/cli.js"
  },
  "scripts": {
    "prepare": "tsc && chmod +x dist/cli.js",
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@toon-format/toon": "^2.0.0",
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
